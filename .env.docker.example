DATABASE_TYPE=
DATABASE_CONNECTIONSTRING=postgres://admin:admin@postgres:5432/governance?sslmode=disable

NATS_URL=nats://nats:4222

# Private Network Hub
PNH_RPC_URL=http://<your-pnh-rpc-url>
PNH_CHAIN_ID=<pnh-chain-id>
PNH_PRIVATE_KEY=<operator-private-key>
PNH_DEPLOYMENT_PROXY_REGISTRY=<proxy-registry-contract-address>
PNH_STARTING_BLOCK=<block-number-to-start-indexing-from>
PNH_OPERATOR_CHAIN_ID=999
PNH_BATCH_SIZE=500

# Rayls View keys (ML-KEM key pair for decrypting participant data)
PNH_RAYLS_VIEW_PUBLIC_KEY=
PNH_RAYLS_VIEW_SECRET_KEY=

# Header proof settings
PNH_HEADER_PROOF_EXPIRATION_PERIOD=5m
PNH_HEADER_PROOF_PURGE_PERIOD=240h

# API
JWTSECRET=<random-secret>
CORSURLS=http://localhost:3000
LOGGING=development

# Flagger (optional, defaults shown)
TRANSACTIONPROCESSOR_BATCHSIZE=
TRANSACTIONPROCESSOR_CHECKINTERVAL=
