{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API (docker)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 4030,
            "host": "0.0.0.0",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/app"
                }
            ]
        },
        {
            "name": "Listener (docker)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 4031,
            "host": "0.0.0.0",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/app"
                }
            ]
        },
        {
            "name": "Flagger (docker)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 4032,
            "host": "0.0.0.0",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/app"
                }
            ]
        },
        {
            "name": "API (local)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/api/main.go",
            "args": [
                "run",
                "--config",
                ".env"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Listener (local)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/listener/main.go",
            "args": [
                "run",
                "--config",
                ".env"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Flagger (local)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/flagger/main.go",
            "args": [
                "run",
                "--config",
                ".env"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}